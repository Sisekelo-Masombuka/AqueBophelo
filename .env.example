# =========================================================================
# AquaBophelo Local Docker Compose Environment Template
# Copy this file to '.env' before running: docker compose -f docker-compose.dev.yml up
#
# IMPORTANT: Generate strong, random secrets for your local environment.
# Example command to generate a 64-char key: openssl rand -base64 48
# =========================================================================

# Database Password for Local SQL Server Container (Requires uppercase, lowercase, numbers, and symbols)
MSSQL_SA_PASSWORD=<YOUR_LOCAL_STRONG_MSSQL_PASSWORD>

# JWT Token Signing Secret for Local Testing (Minimum 64 characters / 512-bit recommended)
JWT_KEY=<YOUR_LOCAL_64_CHAR_HMAC_SHA256_SECRET_KEY>

# Administrator Credentials (Used only when SEED_DATABASE=true)
ADMIN_EMAIL=admin@aquabophelo.app
ADMIN_INITIAL_PASSWORD=<YOUR_INITIAL_DEV_ADMIN_PASSWORD>

# Lifecycle Gates
# Set SEED_DATABASE=true on initial run to seed reference areas and initial routes
SEED_DATABASE=true
# Set MIGRATE_ON_START=true for local docker-compose to apply schema migrations
MIGRATE_ON_START=true

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5094
