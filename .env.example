# =========================================================================
# AquaBophelo Local Docker Compose Environment Template
# Copy this file to '.env' before running: docker compose -f docker-compose.dev.yml up
# =========================================================================

# Database Password for Local SQL Server Container
MSSQL_SA_PASSWORD=LocalDevStrongPassword2026!

# JWT Token Signing Secret for Local Testing (Minimum 64 characters)
JWT_KEY=AquaBopheloLocalDevelopmentSecretKey64ByteLongHmacSha256Testing2026!

# Administrator Credentials (Used only when SEED_DATABASE=true)
ADMIN_EMAIL=admin@aquabophelo.app
ADMIN_INITIAL_PASSWORD=LocalAdminDevPassword2026!

# Lifecycle Gates
SEED_DATABASE=true
MIGRATE_ON_START=true

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5094
