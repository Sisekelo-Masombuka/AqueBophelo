# =========================================================================
# AquaBophelo Municipal Water Management — Backend Environment Configuration Template
# Sol Plaatje Local Municipality (Kimberley, South Africa)
#
# IMPORTANT: This is a sample template. NEVER commit actual production secrets to Git.
# Set these variables in Azure App Service Configuration or your local .env file.
# =========================================================================

# --- Database Connection (SQL Server / Azure SQL) ---
ConnectionStrings__DefaultConnection=Server=tcp:<YOUR_SQL_SERVER_HOST>,1433;Initial Catalog=AquaBopheloDb;Persist Security Info=False;User ID=<YOUR_SQL_USER>;Password=<YOUR_STRONG_SQL_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;

# --- Database Migration & Seeding Lifecycle Gates ---
# Set to 'true' to apply EF Core database migrations on startup. Default: false in production, true in development.
MIGRATE_ON_START=false
# Set to 'true' on the very first deployment to seed municipal areas and base fleet. Set to 'false' in steady-state production runtime.
SEED_DATABASE=false

# --- Demo Data Cleanup Gate ---
# Set to 'true' ONLY in local development when wishing to purge legacy demo data.
# NEVER set to 'true' in production.
PURGE_DEMO_DATA=false

# --- Initial Master Administrator Setup ---
# Required only if SEED_DATABASE=true. In production, rotate immediately after first login.
ADMIN_EMAIL=<ADMINISTRATOR_EMAIL_ADDRESS>
ADMIN_INITIAL_PASSWORD=<PROVISION_STRONG_INITIAL_PASSWORD_HERE>

# --- JWT Authentication (Minimum 256-bit symmetric key) ---
Jwt__Key=<GENERATE_64_BYTE_RANDOM_HMAC_SHA256_KEY_HERE>
Jwt__Issuer=AquaBopheloAPI
Jwt__Audience=AquaBopheloClient
Jwt__ExpiryMinutes=120

# --- Brevo Transactional Email API ---
Brevo__ApiKey=<YOUR_BREVO_API_KEY_HERE>
Brevo__SenderEmail=alerts@aquabophelo.app
Brevo__SenderName=AquaBophelo Municipal Alerts

# --- Cloudflare R2 Object Storage (Citizen Fault & Driver POD Photos) ---
R2__AccountId=<YOUR_CLOUDFLARE_ACCOUNT_ID>
R2__AccessKeyId=<YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID>
R2__SecretAccessKey=<YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY>
R2__BucketName=aquabophelo-reports
R2__PublicDomain=https://media.aquabophelo.app

# --- Cloudflare Turnstile Bot Defense ---
Turnstile__SecretKey=<YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY>

# --- Sentry APM & Crash Diagnostics ---
Sentry__Dsn=<YOUR_SENTRY_BACKEND_DSN>

# --- Firebase Push Notifications ---
# Path to service account JSON file (relative or absolute) or set GOOGLE_APPLICATION_CREDENTIALS
Firebase__ServiceAccountPath=firebase-service-account.json

# --- SignalR Real-Time Scale-Out (Redis Backplane for Multi-Instance Deployments) ---
# Optional: Set this when running multiple backend containers/nodes behind a load balancer
Redis__ConnectionString=<YOUR_REDIS_CONNECTION_STRING_OR_AZURE_CACHE_FOR_REDIS>

# --- ASP.NET Core Data Protection Key Ring Persistence ---
# Optional: Set persistent path (e.g., shared mount /var/keys) for multi-node cookie/token decryption
DataProtection__KeysPath=/var/keys

# --- CORS Allowed Origins ---
Cors__AllowedOrigins__0=https://aquabophelo.app
Cors__AllowedOrigins__1=https://www.aquabophelo.app
