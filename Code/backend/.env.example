# =========================================================================
# AquaBophelo Municipal Water Management — Backend Environment Configuration
# Sol Plaatje Local Municipality (Kimberley, South Africa)
# =========================================================================

# --- Database Connection (SQL Server / Azure SQL) ---
ConnectionStrings__DefaultConnection=Server=tcp:aquabophelo.database.windows.net,1433;Initial Catalog=AquaBopheloDb;Persist Security Info=False;User ID=sqladmin;Password=YourSecurePassword!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;

# --- Database Migration & Seeding Gates ---
# Set to 'true' to apply EF Core database migrations on startup. Default: true.
MIGRATE_ON_START=true
# Set to 'true' on the very first migration or in local development to seed reservoirs and admin.
# Set to 'false' in steady-state production runtime.
SEED_DATABASE=false

# --- Demo Data Cleanup Gate ---
# Set to 'true' ONLY in local development when wishing to purge legacy demo data.
# NEVER set to 'true' in production.
PURGE_DEMO_DATA=false

# --- Initial Master Administrator Setup ---
ADMIN_EMAIL=admin@aquabophelo.app
ADMIN_INITIAL_PASSWORD=ChangeThisToYourSecureAdminPassword123!

# --- JWT Authentication (Minimum 256-bit symmetric key) ---
Jwt__Key=YourSuperSecret64ByteLongJwtSigningKeyForAquaBopheloMunicipalSystem2026!
Jwt__Issuer=AquaBopheloAPI
Jwt__Audience=AquaBopheloClient
Jwt__ExpiryMinutes=120

# --- Brevo Transactional Email API ---
Brevo__ApiKey=xkeysib-your-brevo-api-key-here
Brevo__SenderEmail=alerts@aquabophelo.app
Brevo__SenderName=AquaBophelo Municipal Alerts

# --- Cloudflare R2 Object Storage (Citizen Fault & Driver POD Photos) ---
R2__AccountId=your_cloudflare_account_id
R2__AccessKeyId=your_r2_access_key_id
R2__SecretAccessKey=your_r2_secret_access_key
R2__BucketName=aquabophelo-reports
R2__PublicDomain=https://media.aquabophelo.app

# --- Cloudflare Turnstile Bot Defense ---
Turnstile__SecretKey=0x4AAAAAAAYourTurnstileSecretKeyHere

# --- Sentry APM & Crash Diagnostics ---
Sentry__Dsn=https://your_sentry_dsn@o0.ingest.sentry.io/0

# --- Firebase Push Notifications ---
# Path to service account JSON file (relative or absolute) or set GOOGLE_APPLICATION_CREDENTIALS
Firebase__ServiceAccountPath=firebase-service-account.json

# --- CORS Allowed Origins ---
Cors__AllowedOrigins__0=https://aquabophelo.app
Cors__AllowedOrigins__1=https://www.aquabophelo.app
