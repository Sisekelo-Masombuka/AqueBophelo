# =========================================================================
# AquaBophelo Municipal Water Management — Frontend Environment Configuration
# Sol Plaatje Local Municipality (Kimberley, South Africa)
# =========================================================================

# --- Backend API & Real-time WebSockets ---
# Production: https://api.aquabophelo.app
# Local Development: http://localhost:5094 or https://localhost:7154
VITE_API_BASE_URL=http://localhost:5094
VITE_SIGNALR_URL=http://localhost:5094/hubs/trucks

# --- Cloudflare Turnstile Bot Defense (Public Site Key) ---
# Create in Cloudflare Dashboard -> Turnstile -> Add Site
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAYourTurnstileSiteKeyHere

# --- Sentry Frontend Error Monitoring & APM ---
# Create in Sentry.io -> Projects -> React
VITE_SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

# --- Firebase Cloud Messaging (Web Push Notifications) ---
# Obtain from Firebase Console -> Project Settings -> General & Cloud Messaging
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=aquabophelo-notifications
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-id
VITE_FIREBASE_VAPID_KEY=your-firebase-web-push-vapid-key
